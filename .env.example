# Copy this file to .env and fill in real values locally.
# Never commit the real .env file.

# --- Database ---
DATABASE_URL=postgresql://traffic_user:changeme@localhost:5432/traffic_platform
POSTGRES_USER=traffic_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=traffic_platform

# --- Backend / Auth ---
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173

# --- File Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=500
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov

# --- CV / ML ---
YOLO_MODEL_PATH=./data_science/models/yolov8n.pt
DEFAULT_CONFIDENCE_THRESHOLD=0.4
PROCESSING_FPS=5
YOLO_DEVICE=cpu
YOLO_IMGSZ=640

# --- Object Tracking ---
TRACKER_IOU_THRESHOLD=0.3
TRACKER_MAX_LOST_FRAMES=15
TRACKER_MIN_HITS=1

# --- Vehicle Counting ---
COUNTING_LINE_P1_X=0.0
COUNTING_LINE_P1_Y=0.5
COUNTING_LINE_P2_X=1.0
COUNTING_LINE_P2_Y=0.5
COUNTING_MIN_MOVEMENT_PX=2.0

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

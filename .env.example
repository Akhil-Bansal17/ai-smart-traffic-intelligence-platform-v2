# ==============================================================================
# AI Smart Traffic Intelligence Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in real values locally:
#     cp .env.example .env
#
# IMPORTANT:
# - Never commit the real .env file to version control.
# - In production (ENVIRONMENT=production), SECRET_KEY and POSTGRES_PASSWORD
#   must NOT use default/trivial values.
# ==============================================================================

# --- Application & Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Backend Security / Auth ---
# In production, replace with a 64+ char random string (e.g. openssl rand -hex 32)
SECRET_KEY=replace-with-a-long-random-value-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
# For local development with PostgreSQL:
DATABASE_URL=postgresql://traffic_user:changeme@localhost:5432/traffic_platform
# For Docker Compose execution:
# DATABASE_URL=postgresql://traffic_user:changeme@db:5432/traffic_platform
# For lightweight local testing without PostgreSQL, SQLite can be used:
# DATABASE_URL=sqlite:///./traffic_platform.db

POSTGRES_USER=traffic_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=traffic_platform

# --- CORS ---
# Comma-separated list of allowed web origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# --- File Uploads & Ingestion ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=500
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov

# --- Computer Vision & YOLO Model (Phases 5-9) ---
YOLO_MODEL_PATH=./data_science/models/yolov8n.pt
DEFAULT_CONFIDENCE_THRESHOLD=0.4
PROCESSING_FPS=5
YOLO_DEVICE=cpu
YOLO_IMGSZ=640

# --- Object Tracking (Phase 6) ---
TRACKER_IOU_THRESHOLD=0.3
TRACKER_MAX_LOST_FRAMES=15
TRACKER_MIN_HITS=1

# --- Vehicle Counting (Phase 7) ---
COUNTING_LINE_P1_X=0.0
COUNTING_LINE_P1_Y=0.5
COUNTING_LINE_P2_X=1.0
COUNTING_LINE_P2_Y=0.5
COUNTING_MIN_MOVEMENT_PX=2.0

# --- Anomaly / Incident Detection (Phase 15) ---
ANOMALY_CONGESTION_OCCUPANCY_THRESHOLD=5
ANOMALY_CONGESTION_MIN_DURATION_SECONDS=20.0
ANOMALY_CONGESTION_DENSITY_SCORE_THRESHOLD=0.70
ANOMALY_FLOW_DROP_PCT_THRESHOLD=50.0
ANOMALY_LANE_IMBALANCE_RATIO_THRESHOLD=3.0
ANOMALY_LANE_IMBALANCE_MIN_VOLUME=5
ANOMALY_DENSITY_SPIKE_THRESHOLD=0.00035
ANOMALY_MIN_BUCKETS_FOR_BASELINE=2

# --- Analysis Job Orchestration (Phase 17) ---
MAX_CONCURRENT_ANALYSIS_JOBS=2
JOB_PROGRESS_UPDATE_INTERVAL_FRAMES=5

# --- Traffic Decision Intelligence (Phase 18) ---
INSIGHT_CONGESTION_OCCUPANCY_THRESHOLD=5
INSIGHT_CONGESTION_DENSITY_SCORE_THRESHOLD=0.70
INSIGHT_FLOW_DROP_PCT_THRESHOLD=50.0
INSIGHT_LANE_IMBALANCE_RATIO_THRESHOLD=3.0
INSIGHT_DENSITY_SPIKE_THRESHOLD=0.00035
INSIGHT_HEAVY_VEHICLE_PCT_THRESHOLD=30.0
INSIGHT_SURGE_FLOW_RATE_THRESHOLD=60.0

# --- Business-Grade Reporting & Export (Phase 19) ---
REPORTS_DIR=./reports
MAX_REPORT_TIME_RANGE_DAYS=30
MAX_REPORT_FILE_SIZE_MB=50

# --- Frontend Build & Runtime ---
VITE_API_BASE_URL=http://localhost:8000
